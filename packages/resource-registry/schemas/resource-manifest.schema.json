{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emi-harness.dev/schemas/resource-manifest-v1.json",
  "title": "Controlled EMI Resource Manifest V1",
  "type": "object",
  "required": ["schemaVersion", "resourceId", "version", "kind", "status", "title", "content", "governance"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "resourceId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["emi_context", "skill", "prompt"] },
    "status": { "enum": ["active", "draft", "retired"] },
    "title": { "type": "string", "minLength": 1 },
    "content": { "$ref": "#/$defs/content" },
    "governance": { "$ref": "#/$defs/governance" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statement" }
    },
    "skill": { "$ref": "#/$defs/skill" },
    "prompt": { "$ref": "#/$defs/prompt" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "emi_context" } } },
      "then": { "required": ["applicability", "sources", "statements"] }
    },
    {
      "if": { "properties": { "kind": { "const": "skill" } } },
      "then": { "required": ["skill"] }
    },
    {
      "if": { "properties": { "kind": { "const": "prompt" } } },
      "then": { "required": ["prompt"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "content": {
      "type": "object",
      "required": ["path", "mediaType", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "enum": ["text/markdown", "text/plain"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["owner", "preparedAt", "nextReviewAt", "changePolicy", "confirmationStatus"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "preparedAt": { "type": "string", "format": "date" },
        "nextReviewAt": { "type": "string", "format": "date" },
        "changePolicy": { "const": "manual_review" },
        "confirmationStatus": { "enum": ["engineering_baseline", "human_confirmed", "source_baseline_task_confirmation_required"] }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["jurisdictions", "regulatedEntityTypes", "businessActivities", "exclusions", "taskConfirmationRequired"],
      "properties": {
        "jurisdictions": { "$ref": "#/$defs/nonEmptyStrings" },
        "regulatedEntityTypes": { "$ref": "#/$defs/nonEmptyStrings" },
        "businessActivities": { "$ref": "#/$defs/nonEmptyStrings" },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "taskConfirmationRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "authority", "documentTitle", "documentId", "versionDate", "locator", "canonicalUrl", "retrievedAt", "supportStatus"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "documentTitle": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "versionDate": { "type": "string", "format": "date" },
        "locator": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" },
        "supportStatus": { "enum": ["source_supported", "context_only"] }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "required": ["statementId", "classification", "sourceRefs", "taskConfirmationRequired"],
      "properties": {
        "statementId": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["source_supported", "engineering_derived", "task_confirmation_required"] },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "taskConfirmationRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": ["allowedRoles", "requiredInputs", "outputs", "prohibitedActions"],
      "properties": {
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["coordinator", "executor", "verifier"] }
        },
        "requiredInputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "prohibitedActions": { "$ref": "#/$defs/nonEmptyStrings" }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["allowedRoles"],
      "properties": {
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["coordinator", "executor", "verifier"] }
        }
      },
      "additionalProperties": false
    }
  }
}
